[project]
sub_id = "0527ad55"
name = "projects"
requires = [ "nodejs-24" ]
project_type = "web"

[preview]
preview_enable = "enabled"

[dev]
build = [ "bash", "./scripts/prepare.sh" ]
run = [ "bash", "./scripts/dev.sh" ]
validate = [ "bash", "./scripts/validate.sh" ]
deps = [ "git" ]

[deploy.profile]
kind = "service"
flavor = "web"

[deploy]
build = [ "bash", "./scripts/build.sh" ]
run = [ "bash", "./scripts/start.sh" ]
deps = [ "git" ]

[subprojects]
path = ["."]
